<TabHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/tabhost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THE LODGE MARKETING MACHINE"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="23sp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="British Audiobook Studio"
                android:textColor="@color/gold"
                android:textSize="17sp"
                android:gravity="center" />
        </LinearLayout>

        <TabWidget
            android:id="@android:id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@android:id/tabcontent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/generateTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NARRATION SOURCE"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/selectButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Narration Master File"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/fileStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select the Narration Master file"
                        android:textColor="#555555"
                        android:paddingBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OPENAI ACCESS"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/apiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="OpenAI API key"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/saveKeyButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Save Key Securely"
                            android:layout_marginEnd="5dp" />

                        <Button
                            android:id="@+id/forgetKeyButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Forget Key"
                            android:layout_marginStart="5dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BRITISH NARRATION VOICE"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:paddingTop="16dp" />

                    <Spinner
                        android:id="@+id/voiceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cedar is recommended for the complete book. Marin is clearer and more conversational. Onyx is deeper and more formal."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:paddingTop="6dp"
                        android:paddingBottom="12dp" />

                    <Button
                        android:id="@+id/sampleButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generate British Voice Sample" />

                    <Button
                        android:id="@+id/chapterButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generate or Replace Chapter 1" />

                    <Button
                        android:id="@+id/fullButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generate Remaining Book Chapters" />

                    <com.lodgemarketingmachine.narrator.ExportPackageButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/stopButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stop Safely After Current Request" />

                    <ProgressBar
                        android:id="@+id/progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Each chapter is generated in safe-sized parts and then assembled into one finished M4A chapter file. Finished chapters are stored in Downloads/LodgeMarketingMachineAudio and appear automatically in the Chapter Library. The export button creates one ZIP containing every finished chapter for the final Reader Edition APK."
                        android:textSize="12sp"
                        android:textColor="#555555" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/libraryTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/libraryStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Loading Chapter Library…"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/refreshLibraryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh" />
                </LinearLayout>

                <ListView
                    android:id="@+id/chapterList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:divider="#D8D2C5"
                    android:dividerHeight="1dp"
                    android:background="#FFFFFF"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/nowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select a chapter to begin"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingBottom="6dp" />

                <SeekBar
                    android:id="@+id/playerSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/playerTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/previousButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Previous"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/playPauseButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Play"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/nextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/playerStopButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stop and Return to Start" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your listening position is remembered separately for every chapter. Playback continues automatically into the next chapter."
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:gravity="center"
                    android:paddingTop="6dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</TabHost>
