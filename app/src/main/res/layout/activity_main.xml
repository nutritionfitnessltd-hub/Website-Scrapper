<TabHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/tabhost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THE LODGE MARKETING MACHINE"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="21sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reader and Audiobook Player"
                android:textColor="@color/gold"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>

        <TabWidget
            android:id="@android:id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@android:id/tabcontent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/libraryTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BOOK AND AUDIO LOCATION"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/chooseBookButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose Book File" />

                <TextView
                    android:id="@+id/bookFileStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Narration_Master.md"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/chooseAudioFolderButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose Audio Folder" />

                <TextView
                    android:id="@+id/audioFolderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select the folder containing the M4A, AAC or MP3 chapter files"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/refreshAudioButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Refresh Files"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/continueButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="Continue Reading"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/libraryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose the book file and audio folder"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <ListView
                    android:id="@+id/libraryList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="#D8D2C5"
                    android:dividerHeight="1dp"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/readTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/readTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select a section"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/fontDownButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="A−"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/fontUpButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="A+"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/darkModeButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="Dark mode"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/readScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/readBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select Narration_Master.md from the Library tab."
                        android:textColor="#202020"
                        android:textSize="18sp"
                        android:lineSpacingExtra="5dp"
                        android:textIsSelectable="true" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/readPreviousButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Previous"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/listenThisButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:text="Listen"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/readNextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listenTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHAPTER AUDIO"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center" />

                <Spinner
                    android:id="@+id/listenChapterSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/nowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose the audio folder from the Library tab"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:paddingTop="24dp"
                    android:paddingBottom="12dp" />

                <SeekBar
                    android:id="@+id/playerSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/playerTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/playerPreviousButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Previous"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/playPauseButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Play"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/playerNextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/playerStopButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stop and Return to Start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Playback speed"
                            android:textStyle="bold"
                            android:textColor="@color/navy" />

                        <Spinner
                            android:id="@+id/speedSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sleep timer"
                            android:textStyle="bold"
                            android:textColor="@color/navy" />

                        <Spinner
                            android:id="@+id/sleepSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/sleepStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sleep timer off"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="12dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The narration is AI-generated. The app remembers the selected book file, audio folder, reading position and listening position."
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingTop="12dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</TabHost>
