<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE LODGE MARKETING MACHINE"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="23sp"
            android:gravity="center"
            android:paddingTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reader Edition Installer"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download all four Reader Edition parts into your phone's Downloads folder. This installer will join them, verify the completed app and open Android's installer."
            android:textColor="@color/text"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REQUIRED DOWNLOADS"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/part1Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Part 1: checking…"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/part2Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Part 2: checking…"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/part3Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Part 3: checking…"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/part4Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Part 4: checking…"
            android:textSize="15sp"
            android:padding="8dp" />

        <Button
            android:id="@+id/checkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Downloads Again"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for all four parts."
            android:textColor="@color/text"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/buildButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build and Install Reader Edition"
            android:enabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep at least 650 MB of free storage available. Android may ask you to allow this installer to install unknown apps. Return to this screen after granting permission and the Reader Edition installer will continue automatically."
            android:textColor="#555555"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp" />
    </LinearLayout>
</ScrollView>
