<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE LODGE MARKETING MACHINE"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="24sp"
            android:gravity="center"
            android:paddingTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="British Audiobook Narrator"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Narration Master File" />

        <TextView
            android:id="@+id/fileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No narration file selected"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenAI API key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveKeyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Key Securely"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/forgetKeyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Forget Key"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="British narration voice"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cedar is the recommended warm British book voice. Marin is clearer and more conversational. Onyx is deeper and more formal."
            android:textSize="12sp"
            android:textColor="#555555"
            android:paddingTop="6dp" />

        <Button
            android:id="@+id/sampleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate British Voice Sample"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/chapterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Chapter 1" />

        <Button
            android:id="@+id/fullButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Full Book" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop After Current Part" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8D2C5"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUDIO PLAYER"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/selectAudioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Generated Audio" />

        <TextView
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No audio selected"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/playerSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/playerTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textColor="#555555"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/playerStopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Newly generated audio is loaded automatically. You can also select AAC, MP3 or another supported audio file from your phone."
            android:textSize="12sp"
            android:textColor="#555555"
            android:paddingTop="10dp"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio is AI-generated. Files are saved in Downloads/LodgeMarketingMachineAudio. Your API key is encrypted using Android's device keystore and is never embedded in the APK."
            android:textSize="12sp"
            android:textColor="#555555" />
    </LinearLayout>
</ScrollView>
